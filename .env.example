# Node reads this with: npm run dev
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
# Optional locally. Render generates this automatically in render.yaml.
# Use a permanent random value of at least 24 URL-safe or base64 characters.
CALENDAR_TOKEN=
EVENT_TIME_MODE=date
REFRESH_INTERVAL_HOURS=24
REFRESH_RETRY_MINUTES=30
